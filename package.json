{
  "name": "gentle-spotify",
  "version": "0.1.0",
  "description": "Control the macOS Spotify app from Gentle Shell / Pi with deterministic slash commands and an optional now-playing row in the sidebar.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "gentle-shell",
    "spotify",
    "music"
  ],
  "os": [
    "darwin"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
